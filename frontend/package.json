{
  "name": "growmaster-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test:spacing": "node --test src/gredicnikSpacing.test.js src/plantingCalendar.test.js src/harvestPlanning.test.js",

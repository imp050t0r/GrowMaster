POSTGRES_DB=growmaster
POSTGRES_USER=growmaster
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://growmaster:change-me@database:5432/growmaster
GROWMASTER_DATA_SOURCE=growmaster_app_data
BACKUP_DIR=/data/backups
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost,https://localhost,capacitor://localhost
# Optional Home Assistant API connection for irrigation Kc updates.
# GrowMaster backend uses one address, independent of whether its UI is opened on a PC or phone.
# GrowMaster host is not on Tailscale; choose the HA LAN name/IP reachable from the backend container.
# Example: http://192.168.1.50:8123
# Keep the long-lived access token private; do not commit it or enter it in the browser UI.
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=
# Optional comma-separated HA weather sensor entity IDs. Values are read only for review.
HOME_ASSISTANT_WEATHER_ENTITIES=
